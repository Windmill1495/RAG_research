# Set these to absolute paths before running the experiment.
export ADAQR_PYTHON=python3
export ADAQR_INPUT_SAMPLES=/path/to/qwen-39677-candidate-samples.jsonl
export ADAQR_SFT_ADAPTER=/path/to/qwen-sft-adapter
export ADAQR_CQA_DIR=/path/to/Qwen3-8B
export ADAQR_LLAMA_DIR=/path/to/Llama-3.1-8B-Instruct
export ADAQR_VERIFIER_DIR=/path/to/DeBERTa-v3-base-mnli-fever-anli
export ADAQR_EVIDENCE_LAMBDA=1.0
export ADAQR_LUCENE_INDEX=/path/to/lucene
export ADAQR_COMPONENT_GPUS=0,1
export ADAQR_SCORE_GPUS=0,1
# Optional: override the baseline reward workers, e.g. export ADAQR_REWARD_GPUS=2,3,4,5
# Use 0 to recover the serial BM25 search behavior.
export ADAQR_BM25_BATCH_THREADS=4
export ADAQR_GPU_MIN_FREE_MIB=18500
export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64

# Needed only to reproduce the existing signed 2,000-turn evaluation.
export ADAQR_EVAL_PROJECT_ROOT=/path/to/original/RAG_Research
export ADAQR_BASELINE_RUN=/path/to/frozen/main-test2000
export ADAQR_TEST_SUBSET=/path/to/test_2000.json
export ADAQR_OFFICIAL_TEST=/path/to/qrecc-test.json
